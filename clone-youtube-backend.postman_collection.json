{
  "info": {
    "name": "clone-youtube-backend",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "base_url", "value": "http://localhost:3000/api/v1" },
    { "key": "access_token", "value": "" },
    { "key": "refresh_token", "value": "" },
    { "key": "upload_id", "value": "" }
  ],
  "auth": {
    "type": "bearer",
    "bearer": [{ "key": "token", "value": "{{access_token}}", "type": "string" }]
  },
  "item": [
    {
      "name": "Users",
      "item": [
        {
          "name": "Sign Up",
          "request": {
            "method": "POST",
            "url": "{{base_url}}/users/signup",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"user@example.com\",\n  \"password\": \"at-least-8-chars\",\n  \"first_name\": \"길동\",\n  \"last_name\": \"홍\",\n  \"nickname\": \"hong\"\n}"
            }
          }
        },
        {
          "name": "Sign In",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "if (pm.response.code === 200) {",
                  "  const body = pm.response.json();",
                  "  pm.collectionVariables.set('access_token', body.access_token);",
                  "  pm.collectionVariables.set('refresh_token', body.refresh_token);",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "url": "{{base_url}}/users/signin",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"user@example.com\",\n  \"password\": \"at-least-8-chars\"\n}"
            }
          }
        },
        {
          "name": "Refresh Token",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "if (pm.response.code === 200) {",
                  "  const body = pm.response.json();",
                  "  pm.collectionVariables.set('access_token', body.access_token);",
                  "  pm.collectionVariables.set('refresh_token', body.refresh_token);",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "url": "{{base_url}}/users/refresh",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"refresh_token\": \"{{refresh_token}}\"\n}"
            }
          }
        },
        {
          "name": "Logout",
          "request": { "method": "POST", "url": "{{base_url}}/users/logout" }
        },
        {
          "name": "Logout All",
          "request": { "method": "POST", "url": "{{base_url}}/users/logout-all" }
        }
      ]
    },
    {
      "name": "Email Verification",
      "item": [
        {
          "name": "Send Code",
          "request": {
            "method": "POST",
            "url": "{{base_url}}/verify/send",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"user@example.com\"\n}"
            }
          }
        },
        {
          "name": "Verify Code",
          "request": {
            "method": "POST",
            "url": "{{base_url}}/verify/verify",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"user@example.com\",\n  \"code\": \"123456\"\n}"
            }
          }
        }
      ]
    },
    {
      "name": "Videos",
      "item": [
        {
          "name": "Upload Video",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "if (pm.response.code === 201) {",
                  "  pm.collectionVariables.set('upload_id', pm.response.json().id);",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "url": "{{base_url}}/videos/upload",
            "header": [{ "key": "Content-Type", "value": "video/mp4" }],
            "body": { "mode": "file", "file": {} },
            "description": "Body 탭에서 binary 선택 후 로컬 mp4 파일 첨부하고 Send. id는 서버가 알아서 생성하고 응답에 담아 반환 (자동으로 upload_id 변수에 저장됨). Content-Length는 Postman이 자동 계산."
          }
        },
        {
          "name": "Upload Progress",
          "request": { "method": "GET", "url": "{{base_url}}/videos/upload/{{upload_id}}/progress" }
        },
        {
          "name": "Rendition Status",
          "request": { "method": "GET", "url": "{{base_url}}/videos/{{upload_id}}/renditions" }
        }
      ]
    }
  ]
}
